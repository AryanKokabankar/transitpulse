        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "transitpulse:ingest_lag_seconds:p50",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "transitpulse:ingest_lag_seconds:p95",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "transitpulse:ingest_lag_seconds:p99",
          "legendFormat": "p99"
        }
