{
  "__comment": "Committed to git on purpose: a reviewer can see what the pipeline measures without running anything. Colors are the project palette, assigned by the job each one does - lag percentiles are ORDERED magnitude so they use one blue ramp light-to-dark (never three unrelated hues), sinks are categorical identity (blue/orange, fixed order), and the SLO, dead-letter, partition-headroom and job-freshness tiles use the reserved status palette with the numeric value always visible beside the color. No panel uses two y-axes. Every quantile and the SLI itself read recording rules from observability/prometheus/rules/ rather than recomputing histogram_quantile on each refresh, which also means the objective is defined in exactly one place - the same series the alert rules page on.",
  "title": "TransitPulse / Pipeline Health",
  "uid": "transitpulse-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "transitpulse",
    "slo",
    "pipeline"
  ],
  "templating": {
    "list": [
      {
        "name": "agency",
        "label": "Agency",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(transitpulse_events_processed_total, agency)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Process starts",
        "enable": true,
        "iconColor": "#898781",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "expr": "min by (service_name) (time() - transitpulse_service_start_timestamp_seconds) < 120"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service level",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "SLO compliance - events processed within 2s",
      "description": "Share of events whose end-to-end lag (processed_time - event_time) fell inside the 2s objective. This is the number the project is judged on.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * transitpulse:ingest_lag:within_objective_ratio5m",
          "legendFormat": "within SLO"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 90,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 95
              },
              {
                "color": "#0ca30c",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ingest lag p95",
      "description": "95th percentile end-to-end lag over the last 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "transitpulse:ingest_lag_seconds:p95",
          "legendFormat": "p95 lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 2
              },
              {
                "color": "#ec835a",
                "value": 5
              },
              {
                "color": "#d03b3b",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Throughput",
      "description": "Events written to all enabled sinks, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(transitpulse_events_processed_total{agency=~\"$agency\"}[1m]))",
          "legendFormat": "events/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events dead-lettered (10m)",
      "description": "Events that exhausted all five delivery attempts and could not be quarantined either, so only the DLQ holds them. Was a broker-side depth gauge, which no process in this repo could observe - see ADR-007. Any non-zero value is a durability failure, so the threshold is red at one rather than at a hundred.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(transitpulse_events_dead_lettered_total[10m]))",
          "legendFormat": "dead-lettered"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Error budget burn rate",
      "description": "Multiples of the sustainable spend of the 1% error budget. 1x exhausts a 30-day budget in exactly 30 days; the dashed lines are the two rates that page. Both series are the same quantity over different windows - an ordered family, so one blue ramp light-to-dark with the short window light, rather than two unrelated hues.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "transitpulse:ingest_lag:burn_rate1h",
          "legendFormat": "1h window"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "transitpulse:ingest_lag:burn_rate6h",
          "legendFormat": "6h window"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisGridShow": true,
            "axisSoftMax": 16,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 6
              },
              {
                "color": "#d03b3b",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "1h window"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#86b6ef"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "6h window"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#104281"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "collapsed": false,
      "panels": []
