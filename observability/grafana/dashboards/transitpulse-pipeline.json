{
  "__comment": "Committed to git on purpose: a reviewer can see what the pipeline measures without running anything. Colors are the project palette, assigned by the job each one does - lag percentiles are ORDERED magnitude so they use one blue ramp light-to-dark (never three unrelated hues), sinks are categorical identity (blue/orange, fixed order), and SLO/DLQ tiles use the reserved status palette with the numeric value always visible beside the color. No panel uses two y-axes.",
  "title": "TransitPulse / Pipeline Health",
  "uid": "transitpulse-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "utc",
  "tags": ["transitpulse", "slo", "pipeline"],
  "templating": {
    "list": [
      {
        "name": "agency",
        "label": "Agency",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(transitpulse_events_processed_total, agency)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "enable": true,
        "iconColor": "#898781",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "changes(transitpulse_build_info[1m]) > 0"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service level",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "SLO compliance - events processed within 2s",
      "description": "Share of events whose end-to-end lag (processed_time - event_time) fell inside the 2s objective. This is the number the project is judged on.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum(rate(transitpulse_ingest_lag_seconds_bucket{le=\"2\"}[5m])) / clamp_min(sum(rate(transitpulse_ingest_lag_seconds_count[5m])), 1e-9)",
          "legendFormat": "within SLO"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 90,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 95 },
              { "color": "#0ca30c", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ingest lag p95",
      "description": "95th percentile end-to-end lag over the last 5 minutes.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(transitpulse_ingest_lag_seconds_bucket[5m])))",
          "legendFormat": "p95 lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 2 },
              { "color": "#ec835a", "value": 5 },
              { "color": "#d03b3b", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Throughput",
      "description": "Events written to all enabled sinks, per second.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(transitpulse_events_processed_total{agency=~\"$agency\"}[1m]))",
          "legendFormat": "events/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#2a78d6" }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dead-letter queue depth",
      "description": "Messages parked in the DLQ awaiting replay. Any sustained non-zero value means the replayer job needs to run.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(transitpulse_dlq_depth)",
          "legendFormat": "in DLQ"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#d03b3b", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingest lag percentiles",
      "description": "p50 / p95 / p99 of processed_time - event_time. One blue ramp light-to-dark because these are ordered magnitudes of the same measure, not independent series. The dashed 2s line is the objective.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(transitpulse_ingest_lag_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(transitpulse_ingest_lag_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(transitpulse_ingest_lag_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisGridShow": true,
            "axisSoftMax": 3
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "transparent", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#86b6ef" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#2a78d6" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#104281" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sink write latency p95",
      "description": "Per-sink write latency. Postgres is the synchronous serving write; BigQuery is the batched append. Two independent sinks, so categorical slots 1 and 2.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, sink) (rate(transitpulse_sink_write_duration_seconds_bucket[5m])))",
          "legendFormat": "{{sink}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "postgres" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#2a78d6" } }]
          },
          {
            "matcher": { "id": "byName", "options": "bigquery" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#eb6834" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Data quality",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Quarantined events by reason",
      "description": "Events the pipeline refused, split by why. Categorical identity, so hues are assigned in fixed palette order and a reason keeps its color even when others drop out of the window.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (reason) (increase(transitpulse_events_quarantined_total[5m]))",
          "legendFormat": "{{reason}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisGridShow": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SCHEMA_VALIDATION" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#2a78d6" } }]
          },
          {
            "matcher": { "id": "byName", "options": "DECODE_FAILURE" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#eb6834" } }]
          },
          {
            "matcher": { "id": "byName", "options": "NULL_ISLAND" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1baf7a" } }]
          },
          {
            "matcher": { "id": "byName", "options": "IMPOSSIBLE_SPEED" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#eda100" } }]
          },
          {
            "matcher": { "id": "byName", "options": "STALE_EVENT" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e87ba4" } }]
          },
          {
            "matcher": { "id": "byName", "options": "UNKNOWN_ROUTE" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#008300" } }]
          },
          {
            "matcher": { "id": "byName", "options": "SINK_WRITE_FAILURE" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4a3aa7" } }]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Delivery outcome rate",
      "description": "Processed, deduplicated and quarantined events per second. Deduplicated is a success - the agency re-sending a ping it already sent is normal traffic, not loss - so it is tracked separately from quarantine.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(transitpulse_events_processed_total[1m]))",
          "legendFormat": "processed"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(rate(transitpulse_events_deduped_total[1m]))",
          "legendFormat": "deduplicated"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum(rate(transitpulse_events_quarantined_total[1m]))",
          "legendFormat": "quarantined"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "processed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#2a78d6" } }]
          },
          {
            "matcher": { "id": "byName", "options": "deduplicated" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1baf7a" } }]
          },
          {
            "matcher": { "id": "byName", "options": "quarantined" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#eb6834" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Upstream and internals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Upstream feed fetch p95",
      "description": "How long the agency takes to answer. Single series, so the title names it and no legend box is needed.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(transitpulse_feed_fetch_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 fetch"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#2a78d6" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream feed failures",
      "description": "Fetch errors by kind. Rising values here with flat quarantine means the circuit breaker is doing its job.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (kind) (rate(transitpulse_feed_fetch_failures_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "timeout" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#2a78d6" } }]
          },
          {
            "matcher": { "id": "byName", "options": "http_error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#eb6834" } }]
          },
          {
            "matcher": { "id": "byName", "options": "decode_error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1baf7a" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Processor handler duration p99",
      "description": "Time inside the processor itself, excluding broker and network. Compare against ingest lag to see whether latency is ours or upstream's.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(transitpulse_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 handler"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#2a78d6" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}
