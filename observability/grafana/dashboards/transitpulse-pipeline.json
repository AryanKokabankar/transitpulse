    {
      "id": 7,
      "type": "barchart",
      "title": "Quarantined events by reason",
      "description": "Events the pipeline refused, split by why. An instant query, so this is one bar per reason rather than one per scrape -- asked for a range, a bar chart draws a bar per timestamp and becomes unreadable. Categorical identity, so each reason's hue is pinned by a value mapping and survives other reasons dropping out of the window.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (reason) (increase(transitpulse_events_quarantined_total[5m]))",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisGridShow": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reason"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SCHEMA_VALIDATION": {
                        "color": "#2a78d6",
                        "index": 0,
                        "text": "SCHEMA_VALIDATION"
                      },
                      "DECODE_FAILURE": {
                        "color": "#eb6834",
                        "index": 1,
                        "text": "DECODE_FAILURE"
                      },
                      "NULL_ISLAND": {
                        "color": "#1baf7a",
                        "index": 2,
                        "text": "NULL_ISLAND"
                      },
                      "IMPOSSIBLE_SPEED": {
                        "color": "#eda100",
                        "index": 3,
                        "text": "IMPOSSIBLE_SPEED"
                      },
                      "STALE_EVENT": {
                        "color": "#e87ba4",
                        "index": 4,
                        "text": "STALE_EVENT"
                      },
                      "UNKNOWN_ROUTE": {
                        "color": "#008300",
                        "index": 5,
                        "text": "UNKNOWN_ROUTE"
                      },
                      "SINK_WRITE_FAILURE": {
                        "color": "#4a3aa7",
                        "index": 6,
                        "text": "SINK_WRITE_FAILURE"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xField": "reason",
        "colorByField": "reason"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "events"
            }
          }
        }
      ]
    },
    {
