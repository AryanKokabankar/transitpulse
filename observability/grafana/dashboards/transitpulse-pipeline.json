      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "transitpulse:sink_write_seconds:p95",
          "legendFormat": "{{sink}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false
