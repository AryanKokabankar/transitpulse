# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# env / secrets
.env
.env.local
*-sa-key.json
service-account*.json

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is deliberately NOT ignored. It pins the exact provider
# versions and their checksums, which is what makes two people -- or a laptop
# and CI -- resolve the same providers. Ignoring it is a common default and
# the wrong one for a configuration that is applied from more than one place.

# local data
data/
replay-corpus/
*.pb
*.log

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
