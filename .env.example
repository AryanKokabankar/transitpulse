# ---------------------------------------------------------------------
# TransitPulse local configuration. Copy to .env and adjust.
# Every value here has a working local default in docker-compose.
# ---------------------------------------------------------------------

TP_ENV=local
TP_LOG_LEVEL=INFO

# --- GTFS-Realtime feed -----------------------------------------------
# MBTA's vehicle-positions feed needs no API key, so `python tasks.py capture`
# works on a fresh clone. Any GTFS-Realtime endpoint can be substituted.
TP_FEED_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
TP_FEED_AGENCY=mbta

# MTA NYCT, for comparison, now returns 403 without a registered API key.
# Request one at https://api.mta.info/ and append it as the feed expects:
# TP_FEED_URL=https://api-endpoint.mta.info/Dataservices/mtagtfsfeeds/nyct%2Fgtfs
# TP_FEED_AGENCY=mta-nyct
TP_FEED_TIMEOUT_SECONDS=10.0

# --- Pub/Sub (emulator locally) ---------------------------------------
PUBSUB_EMULATOR_HOST=localhost:8085
TP_GCP_PROJECT=transitpulse-local
TP_TOPIC_VEHICLE_EVENTS=vehicle-events
TP_SUBSCRIPTION_PROCESSOR=vehicle-events-processor
TP_TOPIC_DLQ=vehicle-events-dlq
TP_SUBSCRIPTION_DLQ=vehicle-events-dlq-replayer

# --- PostgreSQL -------------------------------------------------------
TP_PG_DSN=postgresql://transitpulse:transitpulse@localhost:5432/transitpulse
TP_PG_POOL_MIN=2
TP_PG_POOL_MAX=10

# --- BigQuery (disabled locally; processor writes to Postgres only) ---
TP_BQ_ENABLED=false
TP_BQ_DATASET=transitpulse
TP_BQ_TABLE=vehicle_events
TP_BQ_BATCH_SIZE=500
TP_BQ_BATCH_TIMEOUT_SECONDS=2.0

# --- Object storage for the replay corpus -----------------------------
TP_SNAPSHOT_BUCKET=transitpulse-snapshots
TP_SNAPSHOT_LOCAL_DIR=./replay-corpus

# --- OpenTelemetry ----------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=transitpulse
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# The SDK default is 60s, which is longer than most local runs and far
# longer than Prometheus's 5s scrape: a 30-second load test would land one
# point and every panel would look flat. Cloud deployments leave it at the
# default, where the export cost matters and the runs are not 30 seconds.
OTEL_METRIC_EXPORT_INTERVAL=5000
TP_OTEL_ENABLED=true
TP_OTEL_CONSOLE_EXPORT=false
